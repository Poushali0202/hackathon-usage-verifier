     "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}"
    },
    "parameters": {}
   },
   "control": [
    {
     "classType": "llm",
     "from": "agent_rocketride_1"
    }
   ]
  },
  {
   "id": "memory_internal_1",
   "provider": "memory_internal",
   "config": {
    "type": "memory_internal"
   },
   "control": [
    {
     "classType": "memory",
     "from": "agent_rocketride_1"
    }
   ]
  },
  {
   "id": "tool_python_1",
   "provider": "tool_python",
   "config": {
    "type": "tool_python",
    "timeout": 600,
    "allowedModules": [
     {
      "moduleName": "urllib.request"
     },
     {
      "moduleName": "urllib.parse"
     },
     {
      "moduleName": "urllib.error"
     },
     {
      "moduleName": "hashlib"
     },
     {
      "moduleName": "dataclasses"
     },
     {
      "moduleName": "datetime"
     }
    ]
   },
   "control": [
    {
     "classType": "tool",
     "from": "agent_rocketride_1"
    }
   ]
  },
  {
   "id": "response_answers_1",
   "provider": "response_answers",
   "config": {},
   "input": [
    {
