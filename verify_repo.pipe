{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      }
    },
    {
      "id": "agent_1",
      "provider": "agent_crewai",
      "config": {
        "type": "agent_crewai",
        "instructions": "You are a deterministic job runner. The user message is a JSON object with keys base_url and job_id. Take the Python code between <code> and </code> EXACTLY as written, replacing only __BASE_URL__ with the base_url value and __JOB_ID__ with the job_id value, then call the python code execution tool exactly once with that code as the code argument. Reply with only the tool output. Never write your own code.\n<code>\nimport json, hashlib\nimport urllib.request\nBASE = \"__BASE_URL__\"\nJOB = \"__JOB_ID__\"\ndef _get(u):\n    with urllib.request.urlopen(u, timeout=90) as r:\n        return r.read().decode(\"utf-8\", \"replace\")\njob = json.loads(_get(BASE + \"/api/node/job/\" + JOB))\ncode = _get(BASE + \"/api/node/bundle.py\")\nif hashlib.sha256(code.encode(\"utf-8\")).hexdigest() != job[\"bundle_sha\"]:\n    raise SystemExit(\"bundle integrity check failed\")\nns = {}\nexec(code, ns)\nTOKEN = job.get(\"gh_token\") or \"\"\ndef gh(url):\n    hdrs = {\"User-Agent\": \"hackjudge-node\"}\n    if TOKEN and (\"api.github.com\" in url or \"raw.githubusercontent.com\" in url):\n        hdrs[\"Authorization\"] = \"Bearer \" + TOKEN\n    req = urllib.request.Request(url, headers=hdrs)\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            return r.status, r.read().decode(\"utf-8\", \"replace\")\n    except Exception as e:\n        return getattr(e, \"code\", 0) or 0, \"\"\nres = ns[\"run_verify\"](job[\"repo_url\"], job[\"target_config\"], gh, job.get(\"event_date\"), job.get(\"history_penalty\"))\ndata = json.dumps({\"token\": job[\"cb_token\"], \"result\": res}).encode(\"utf-8\")\nreq = urllib.request.Request(BASE + \"/api/node/result/\" + JOB, data=data, headers={\"Content-Type\": \"application/json\"})\nwith urllib.request.urlopen(req, timeout=90) as r:\n    r.read()\nprint(\"VERIFIED tag=\" + str(res.get(\"tag\")) + \" score=\" + str(res.get(\"score\")))\n</code>",
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
    {
      "id": "llm_1",
      "provider": "llm_anthropic",
      "config": {
        "profile": "claude-haiku-4-5",
        "claude-haiku-4-5": {
          "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}"
        },
        "parameters": {}
      },
      "control": [
        {
          "classType": "llm",
          "from": "agent_1"
        }
      ]
    },
    {
      "id": "tool_1",
      "provider": "tool_python",
      "config": {
        "type": "tool_python",
        "timeout": 600,
        "allowedModules": [
          {
            "moduleName": "urllib"
          },
          {
            "moduleName": "urllib.request"
          },
          {
            "moduleName": "urllib.parse"
          },
          {
            "moduleName": "urllib.error"
          },
          {
            "moduleName": "http"
          },
          {
            "moduleName": "http.client"
          },
          {
            "moduleName": "ssl"
          },
          {
            "moduleName": "socket"
          },
          {
            "moduleName": "hashlib"
          },
          {
            "moduleName": "dataclasses"
          },
          {
            "moduleName": "datetime"
          },
          {
            "moduleName": "collections"
          },
          {
            "moduleName": "typing"
          }
        ]
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_1"
        }
      ]
    },
    {
      "id": "resp_1",
      "provider": "response_answers",
      "config": {},
      "input": [
        {
          "lane": "answers",
          "from": "agent_1"
        }
      ]
    }
